APP_NAME="FAGE Ghana"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost
APP_TIMEZONE=Africa/Accra
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12
LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=error

# Database: change to mysql for production
DB_CONNECTION=sqlite
DB_DATABASE=database/database.sqlite

# MySQL (use for production on cPanel)
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=fage_ghana
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
CACHE_STORE=database
QUEUE_CONNECTION=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS=noreply@fageghana.org
MAIL_FROM_NAME="FAGE Ghana"

SANCTUM_STATEFUL_DOMAINS=localhost
